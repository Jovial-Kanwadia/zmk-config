#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    /* LEFT SIDE: Shifted for Pin 10 | RIGHT SIDE: Normal */
    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp ESC        &kp N6   &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp TAB        &kp Y    &kp U    &kp I     &kp O   &kp P    &kp EQUAL
    &kp A  &kp S  &kp D  &kp F  &kp G  &kp LSHFT      &kp H    &kp J    &kp K     &kp L   &kp SEMI &kp SQT
    &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LCTRL      &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH &kp BSLH
    &kp GRAVE &kp UP &kp DOWN &kp LEFT &kp RIGHT &kp LALT   &kp HOME &kp PGDN &kp PGUP  &kp END &kp LBKT &kp RBKT
    &kp SPACE &kp SPACE &kp SPACE &kp RET &kp RET &mo 1     &kp BSPC &kp BSPC &kp DEL   &kp DEL &kp RET  &kp RSHFT
            >;
        };

        lower_layer {
            bindings = <
    /* LEFT SIDE | RIGHT SIDE */
    &trans &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &trans &trans &trans         &trans &trans &trans &trans &trans &trans
    &trans &trans &trans &bt BT_CLR &bt BT_NXT &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
