#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    /* Row 0: Numbers */
    &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5         &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
    /* Row 1: Top Row */
    &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y     &kp U     &kp I     &kp O     &kp P     &kp EQUAL
    /* Row 2: Home Row */
    &kp LSHFT &kp A     &kp S     &kp D     &kp F     &kp G          &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
    /* Row 3: Bottom Row */
    &kp LCTRL &kp Z     &kp X     &kp C     &kp V     &kp B          &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp BSLH
    /* Row 4: Lower Modifiers & Brackets */
    &kp LALT  &kp GRAVE &kp LGUI  &kp LALT  &kp LBKT  &kp RBKT       &kp UP    &kp DOWN  &kp LEFT  &kp RIGHT &kp HOME  &kp END
    /* Row 5: Thumb Clusters */
    /* Left Thumb: Modifiers & Space | Right Thumb: Backspace, Enter, Delete, BT */
    &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &kp SPACE &kp SPACE      &kp RET   &kp RET   &kp BSPC  &kp DEL   &bt BT_CLR &bt BT_NXT
            >;
        };
    };
};
