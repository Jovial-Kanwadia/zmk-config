#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <75>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
            /* LEFT                                                                        RIGHT */
            &kp ESC     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6       &kp N7       &kp N8       &kp N9       &kp N0         &kp BSPC
            &kp TAB     &kp Q        &kp W        &kp E        &kp R        &kp T          &kp Y        &kp U        &kp I        &kp O        &kp P          &kp MINUS
            &kp LSHFT   &mt LSHFT A  &mt LCTRL S  &mt LALT D   &mt LGUI F   &kp G          &kp H        &mt RGUI J   &mt RALT K   &mt RCTRL L  &mt RSHFT SEMI &kp SQT
            &kp LCTRL   &kp Z        &kp X        &kp C        &kp V        &kp B          &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH       &kp BSLH
            &kp LBKT    &kp RBKT     &kp UP       &kp DOWN     &kp LEFT     &kp RIGHT      &kp HOME     &kp PGDN     &kp PGUP     &kp END      &kp MINUS      &kp EQUAL
            &kp TAB     &mo RAISE    &mo LOWER    &mo ADJUST   &kp SPACE    &kp ENTER      &kp ENTER    &mo ADJUST   &mo LOWER    &mo RAISE    &kp BSPC       &kp DEL
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
            &kp F1      &kp F2       &kp F3       &kp F4       &kp F5       &kp F12        &kp F6       &kp F7       &kp F8       &kp F9       &kp F10        &kp F11
            &trans      &trans       &trans       &trans       &trans       &trans         &kp C_VOL_UP &kp UP       &trans       &trans       &kp PG_UP      &trans
            &kp PSCRN   &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans       &kp CAPS       &kp C_VOL_DN &kp LEFT     &kp DOWN     &kp RIGHT    &kp PG_DN      &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &kp HOME     &kp END      &kp INS      &kp DEL      &kp C_MUTE     &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            &kp N1      &kp N2       &kp N3       &kp N4       &kp N5       &kp N6         &kp N7       &kp N8       &kp N9       &kp N0       &kp MINUS      &kp EQUAL
            &kp EXCL    &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &trans         &kp CARET    &kp AMPS     &kp ASTRK    &kp LPAR     &kp RPAR       &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            &trans      &trans       &trans       &trans       &trans       &trans         &trans       &trans       &trans       &trans       &trans         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
                /* Row 1: Bluetooth Profiles & Clear Current */
            &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR       &none  &none  &none  &none  &none  &none

                /* Row 2: Output Selection & ZMK Studio Unlock */
            &out OUT_BLE   &out OUT_USB &none        &none        &none        &studio_unlock   &none  &none  &none  &none  &none  &none

                /* Row 3: Clear ALL Profiles */
            &bt BT_CLR_ALL &none        &none        &none        &none        &none            &none  &none  &none  &none  &none  &none

                /* Row 4 */
            &none          &none        &none        &none        &none        &none            &none  &none  &none  &none  &none  &none

                /* Row 5 */
            &none          &none        &none        &none        &none        &none            &none  &none  &none  &none  &none  &none

                /* Row 6 */
            &none          &none        &none        &none        &none        &none            &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
