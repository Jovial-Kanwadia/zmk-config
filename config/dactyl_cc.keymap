#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

// Mouse movement speed
#define MOUSE_MOVE_SPEED 1500

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <75>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // LEFT SIDE: Outer column shifted to end | RIGHT SIDE: Normal
            bindings = <
    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5 &kp ESC        &kp N6 &kp N7       &kp N8       &kp N9       &kp N0         &kp MINUS
    &kp Q        &kp W        &kp E        &kp R        &kp T  &kp TAB        &kp Y  &kp U        &kp I        &kp O        &kp P          &kp EQUAL
    &mt LSHFT A  &mt LCTRL S  &mt LALT D   &mt LGUI F   &kp G  &kp LSHFT      &kp H  &mt RGUI J   &mt RALT K   &mt RCTRL L  &mt RSHFT SEMI &kp SQT
    &kp Z        &kp X        &kp C        &kp V        &kp B  &kp LCTRL      &kp N  &kp M        &kp COMMA    &kp DOT      &kp FSLH       &kp BSLH
    &kp RBKT     &kp UP       &kp DOWN     &kp LEFT     &kp RIGHT &kp LBKT    &kp HOME &kp PGDN   &kp PGUP     &kp END      &kp MINUS      &kp EQUAL
    &kp TAB      &mo RAISE    &mo LOWER    &mo ADJUST   &kp ESC &kp SPACE     &kp ENTER &mo ADJUST &mo LOWER   &mo RAISE    &kp BSPC       &kp SPACE
            >;
        };

        lower_layer {
            bindings = <
    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5 &kp F12        &kp F6       &kp F7     &kp F8     &kp F9     &kp F10 &kp F11
    &trans       &trans       &trans       &trans       &trans &trans         &kp C_VOL_UP &trans     &kp UP     &trans     &kp PG_UP &trans
    &kp PSCRN    &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans &kp CAPS       &kp C_VOL_DN &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN &trans
    &trans       &trans       &trans       &trans       &trans &trans         &kp C_MUTE   &kp HOME   &kp END    &kp INS    &kp DEL &trans
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &trans     &trans  &trans
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &trans     &trans  &trans
            >;
        };

        raise_layer {
            bindings = <
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &trans     &trans  &trans
    &kp N2       &kp N3       &kp N4       &kp N5       &trans &kp N1         &kp N6       &kp N7     &kp N8     &kp N9     &kp N0  &trans
    &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &trans &kp EXCL       &kp CARET    &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR &trans
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &kp SQT    &kp BSLH &trans
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &trans     &trans  &trans
    &trans       &trans       &trans       &trans       &trans &trans         &trans       &trans     &trans     &trans     &trans  &trans
            >;
        };

        adjust_layer {
            bindings = <
    &none        &none        &none        &none        &none  &none          &none        &none           &none           &none            &none &none
    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none  &bt BT_SEL 0   &none        &mmv MOVE_UP    &none           &none            &none &none
    &out OUT_BLE &bt BT_CLR   &none        &bt BT_CLR_ALL &none &out OUT_USB  &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none &none
    &mkp RCLK    &none        &none        &none        &none  &mkp LCLK      &none        &none           &none           &none            &none &none
    &none        &none        &none        &none        &none  &none          &none        &none           &none           &none            &none &none
    &none        &none        &none        &none        &none  &none          &none        &none           &none           &none            &none &none
            >;
        };
    };
};
